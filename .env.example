# ── Supabase (database, organiser login, media storage) ─────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SECRET — server only. Never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=media

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_FEST_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_FEST_TZ_OFFSET=+05:30
# Random string used to hash participant IPs for abuse tracking
IP_HASH_SALT=change-me-to-a-long-random-string

# ── Emails — https://resend.com ─────────────────────────────────────────────
# Sign up to Resend WITH the festival inbox (animaux.zoology@gmail.com). With just
# the API key, a copy of every registration + help-desk message goes to that inbox.
RESEND_API_KEY=
ORGANISER_EMAIL=animaux.zoology@gmail.com
# Optional, needs a domain verified in Resend: also emails participants a confirmation.
EMAIL_FROM=

# ── Local development without Supabase ONLY ─────────────────────────────────
# Used only when the Supabase variables above are empty. Ignored on Vercel.
LOCAL_ADMIN_PASSWORD=
LOCAL_SESSION_SECRET=
