/**
 * Writes supabase/seed.sql from src/content so the starter content can be
 * loaded by pasting into the Supabase SQL Editor (no local Node needed).
 *   npx tsx scripts/make-seed-sql.mts
 */
import { readFileSync, writeFileSync } from "node:fs";
import { eventsSeed } from "../src/content/events";
import { announcementsSeed, faqsSeed, festivalSeed, scheduleSeed } from "../src/content/festival";
import { gallerySeed } from "../src/content/gallery";
import { teamSeed } from "../src/content/team";

const snake = (k: string) => k.replace(/[A-Z]/g, (m) => `_${m.toLowerCase()}`);
const lit = (v: unknown): string => {
  if (v === null || v === undefined) return "null";
  if (typeof v === "boolean" || typeof v === "number") return String(v);
  if (typeof v === "object") return `'${JSON.stringify(v).replace(/'/g, "''")}'::jsonb`;
  return `'${String(v).replace(/'/g, "''")}'`;
};

const upsert = (table: string, rows: object[]) =>
  rows
    .map((r) => {
      const cols = Object.keys(r);
      const set = cols.filter((c) => c !== "id").map((c) => `"${snake(c)}" = excluded."${snake(c)}"`).join(", ");
      return `insert into public.${table} (${cols.map((c) => `"${snake(c)}"`).join(", ")}) values (${cols.map((c) => lit((r as Record<string, unknown>)[c])).join(", ")}) on conflict (id) do update set ${set};`;
    })
    .join("\n");

/** Removes starter rows from older versions of this file (never rows you added yourself). */
const prune = (table: string, prefix: string, keep: { id: string }[], extra = "") =>
  `delete from public.${table} where id::text like '${prefix}%'${keep.length ? ` and id not in (${keep.map((r) => `'${r.id}'`).join(", ")})` : ""}${extra};`;

const sql = [
  "-- ANIMAUX'26 starter content. Generated by scripts/make-seed-sql.mts.",
  "-- Run in Supabase → SQL Editor (after the first-time init migration). Re-running resets these starter rows",
  "-- (events, team, schedule, FAQs, announcements, settings) to the values below: dashboard edits to",
  "-- those rows are overwritten, rows you added yourself are kept.",
  "-- Schema updates first (all idempotent), so this file works even if a migration was skipped.",
  readFileSync("supabase/migrations/20261111000000_survival_files.sql", "utf8"),
  readFileSync("supabase/migrations/20261112000000_prizes_sponsors.sql", "utf8"),
  "begin;",
  // Old placeholder events from the first draft (kept if anyone already registered for them).
  prune("events", "e0000000-", [], " and not exists (select 1 from public.registrations r where r.event_id = events.id)"),
  upsert("events", eventsSeed),
  prune("team_members", "7e000000-", teamSeed),
  upsert("team_members", teamSeed),
  prune("gallery_items", "9a000000-", gallerySeed),
  upsert("gallery_items", gallerySeed),
  upsert("announcements", announcementsSeed),
  prune("schedule_items", "5c000000-", scheduleSeed),
  upsert("schedule_items", scheduleSeed),
  prune("faqs", "fa000000-", faqsSeed),
  upsert("faqs", faqsSeed),
  `insert into public.festival_settings (id, data) values (1, ${lit(festivalSeed)}) on conflict (id) do update set data = excluded.data;`,
  "commit;",
  "",
].join("\n\n");

writeFileSync("supabase/seed.sql", sql);
console.log("wrote supabase/seed.sql");
